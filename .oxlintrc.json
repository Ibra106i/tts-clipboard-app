{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/jsx-key": "error",
    // The app uses the automatic JSX runtime (tsconfig `jsx: react-jsx`), so
    // requiring `React` in scope is obsolete here.
    "react/react-in-jsx-scope": "off",
    // Reading text is an immutable, order-stable list of paragraphs split from
    // one string; there is no stable identity to key on, and index keys cannot
    // cause the reorder bugs this rule exists to prevent.
    "react/no-array-index-key": "off",
    // Book imports are intentionally serialised: parsing is CPU-bound and
    // running several at once starves the UI thread.
    "no-await-in-loop": "off",
    "react/jsx-no-target-blank": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "typescript/consistent-type-imports": "warn",
    "no-empty": "error",
    "no-console": ["warn", { "allow": ["error", "warn"] }],
    "no-debugger": "error",
    "no-var": "error",
    "eqeqeq": ["error", "smart"],
    "no-duplicate-imports": "error",
    "no-throw-literal": "error",
    "prefer-const": "warn",
    "dot-notation": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "no-console": "off"
      }
    }
  ]
}
